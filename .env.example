# ── Shared ───────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=                       # sk-ant-... from console.anthropic.com
GITHUB_TOKEN=                         # github_pat_... with repo + workflow scopes
GITHUB_OWNER=                         # your GitHub username
GITHUB_REPO=demo-app

SONARQUBE_TOKEN=                      # squ_... from SonarQube admin → Security
SONARQUBE_WEBHOOK_SECRET=             # any random 32-char string

AUTH0_DOMAIN=                         # your-tenant.auth0.com
AUTH0_AUDIENCE=                       # https://patchpilot-api

# ── Local Docker Compose ─────────────────────────────────────────────────────
SONARQUBE_URL=http://sonarqube:9000
ARTIFACTORY_URL=http://artifactory:8082/artifactory
ARTIFACTORY_USER=admin
ARTIFACTORY_PASSWORD=

POSTGRES_DB=patchpilot
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=                    # local only — use something different from Azure

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/patchpilot
SPRING_DATASOURCE_USERNAME=patchpilot
SPRING_DATASOURCE_PASSWORD=

JENKINS_PORT=8080
SONARQUBE_PORT=9000
ARTIFACTORY_PORT=8082
AI_AGENT_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
POSTGRES_PORT=5432
ANGULAR_PORT=4200

# ── Azure ────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-patchpilot
AZURE_LOCATION=canadaeast
ACR_NAME=                             # globally unique, lowercase, no hyphens
ACR_LOGIN_SERVER=
CONTAINER_APP_NAME=patchpilot-ai-agent
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_PASSWORD=              # DIFFERENT from local — strong random password
AZURE_SPRING_DATASOURCE_URL=          # jdbc:postgresql://...?sslmode=require
